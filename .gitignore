# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches and coverage output
.pytest_cache/
.ruff_cache/
.coverage
coverage.json
# Locust output of a load run (Phase 14): numbers only, but regenerated every run
load_out/

# Ingestion keeps the original PDFs here (Phase 5). It is the ONLY copy: back it up yourself.
originals/

# Evaluation (Phase 13): the local results database, the scratch database of a run and the
# test-collection ingest folders. Local data of the admin machine.
eval_data/

# Secrets (.env.example is kept: it holds placeholders only)
.env*
!.env.example

# Qdrant snapshots copied down by scripts/qdrant_snapshot.py (Phase 15)
backups/

# Local run leftovers: a log of the API in a terminal, a throw-away SQLite file (Phase 15)
*.log
*.db
