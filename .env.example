# BFSI RAG Assistant: settings template (spec section 17.4).
#
# How to use: copy this file to a new file named .env and fill in your own values.
# Never commit .env and never paste a value from it into a chat, ticket or log.
# This template holds names and plain-language comments only, never values.
#
# "Where" tells you where the variable is used:
#   Render and local    = set on the Render hosting service and on your machine
#   admin machine only  = only on your machine, never on Render
#
# [P] means the variable name is a proposal. The spec itself names only
# GROQ_API_KEYS (as an example, section 2) and DEV_STAGE_TRACE (section 14);
# every other name was chosen by the builder. Confirm or rename them.
# Later phases add the variables they need to this file.

# ---------------------------------------------------------------------------
# Answer and decision models (spec section 2)
# ---------------------------------------------------------------------------

# Groq API keys from different accounts, separated by commas (up to four).
# [P] Name taken from the spec's example in section 2.
# Where: Render and local
GROQ_API_KEYS=

# Google Gemini API keys for answers, separated by commas (up to four).
# [P] Name chosen by the builder, following the GROQ_API_KEYS pattern.
# Where: Render and local
GEMINI_API_KEYS=

# OpenRouter API keys for answers, separated by commas (up to four).
# [P] Name chosen by the builder, following the GROQ_API_KEYS pattern.
# Where: Render and local
OPENROUTER_API_KEYS=

# The separate OpenRouter key used only for the Jev decision model.
# [P] Name chosen by the builder; the spec only says Jev has its own key.
# Where: Render and local
JEV_OPENROUTER_API_KEY=

# Two Google Gemini keys from two different accounts, used for embeddings.
# Key B is used when key A fails.
# [P] Names chosen by the builder; the spec only says "two Google embedding keys".
# Where: Render and local
GEMINI_EMBEDDING_KEY_A=
GEMINI_EMBEDDING_KEY_B=

# Cohere key for reranking search results.
# [P] Name chosen by the builder.
# Where: Render and local
COHERE_API_KEY=

# Jina key, the backup reranker if Cohere is down.
# [P] Name chosen by the builder.
# Where: Render and local
JINA_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation keys (spec section 2): separate from the production keys above
# ---------------------------------------------------------------------------

# Evaluation keys, separated by commas. They are never installed on Render.
# [P] Names chosen by the builder; the spec only says eval keys are separate.
# Where: admin machine only
EVAL_GROQ_API_KEYS=
EVAL_GEMINI_API_KEYS=
EVAL_OPENROUTER_API_KEYS=

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# Web address of your Qdrant cloud cluster (vector search).
# Leave it unset when you run tests: tests use an in-memory Qdrant.
# [P] Name chosen by the builder.
# Where: Render and local
QDRANT_URL=

# API key of your Qdrant cloud cluster.
# [P] Name chosen by the builder.
# Where: Render and local
QDRANT_API_KEY=

# Main database: a cloud Postgres connection URL (Neon or Supabase), for example
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# TLS is required: keep sslmode=require in the URL. When you run migrations, use
# the provider's DIRECT connection URL, not the pooled one (the pooled host on
# Neon contains "-pooler"; Supabase calls it the transaction pooler).
# Tests never use this: they use SQLite, and refuse to run if this points at a
# remote host. Put it in your shell only when you run migrations or the app.
# [P] Name chosen by the builder.
# Where: Render and local
DATABASE_URL=

# Evaluation database: a separate cloud Postgres database (same URL format and
# TLS rule as above) that holds PRODUCTION evaluation results only. Local
# evaluation results go to a SQLite file by default (confirmed in Phase 13).
# [P] Name chosen by the builder.
# Where: admin machine only
EVAL_DATABASE_URL=

# Upstash Redis address for the answer cache and rate limits (starts with rediss://).
# [P] Name chosen by the builder.
# Where: Render and local
UPSTASH_REDIS_URL=

# ---------------------------------------------------------------------------
# Tracing, alerts and security
# ---------------------------------------------------------------------------

# Langfuse project keys and the address of your Langfuse region (tracing).
# [P] Names chosen by the builder, following Langfuse's own documentation.
# Where: Render and local
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Secret used to sign login tokens. Use a long random string, different on
# every environment.
# [P] Name chosen by the builder.
# Where: Render and local
JWT_SECRET_KEY=

# The web address of the Streamlit frontend, the only site allowed to call the API.
# [P] Name chosen by the builder.
# Where: Render and local
CORS_ALLOWED_ORIGIN=

# Web address of the chat webhook that receives alerts (no email in this version).
# [P] Name chosen by the builder.
# Where: Render and local
ALERT_WEBHOOK_URL=

# Set to true to print each pipeline stage and its timing in your terminal while
# a query runs. Leave empty everywhere else; it must stay off on Render.
# The spec names this flag (section 14).
# Where: admin machine only
DEV_STAGE_TRACE=
