# BFSI RAG Assistant: settings template (spec section 17.4).
#
# How to use: copy this file to a new file named .env and fill in your own values.
# Never commit .env and never paste a value from it into a chat, ticket or log.
# This template holds names and plain-language comments only, never values.
#
# "Where" tells you where the variable is used:
#   Render and local    = set on the Render hosting service and on your machine
#   admin machine only  = only on your machine, never on Render
#
# [P] means the variable name is a proposal. The spec itself names only
# GROQ_API_KEYS (as an example, section 2) and DEV_STAGE_TRACE (section 14);
# every other name was chosen by the builder. Confirm or rename them.
# Later phases add the variables they need to this file.

# ---------------------------------------------------------------------------
# Answer and decision models (spec section 2)
# ---------------------------------------------------------------------------

# Groq API keys from different accounts, separated by commas (up to four).
# [P] Name taken from the spec's example in section 2.
# Where: Render and local
GROQ_API_KEYS=

# Google Gemini API keys for answers, separated by commas (up to four).
# [P] Name chosen by the builder, following the GROQ_API_KEYS pattern.
# Where: Render and local
GEMINI_API_KEYS=

# OpenRouter API keys for answers, separated by commas (up to four).
# [P] Name chosen by the builder, following the GROQ_API_KEYS pattern.
# Where: Render and local
OPENROUTER_API_KEYS=

# The separate OpenRouter key used only for the Jev decision model.
# [P] Name chosen by the builder; the spec only says Jev has its own key.
# Where: Render and local
JEV_OPENROUTER_API_KEY=

# Two Google Gemini keys from two different accounts, used for embeddings.
# Key B is used when key A fails.
# [P] Names chosen by the builder; the spec only says "two Google embedding keys".
# Where: Render and local
GEMINI_EMBEDDING_KEY_A=
GEMINI_EMBEDDING_KEY_B=

# Cohere key for reranking search results.
# [P] Name chosen by the builder.
# Where: Render and local
COHERE_API_KEY=

# Jina key, the backup reranker if Cohere is down.
# [P] Name chosen by the builder.
# Where: Render and local
JINA_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation keys (spec section 2): separate from the production keys above
# ---------------------------------------------------------------------------

# Evaluation keys, separated by commas. They are never installed on Render.
# [P] Names chosen by the builder; the spec only says eval keys are separate.
# Where: admin machine only
# EVAL_GROQ_API_KEYS and EVAL_GEMINI_API_KEYS are reserved for the evaluation phase: nothing
# reads them yet. EVAL_OPENROUTER_API_KEYS is read by the gateway. The gateway refuses to start
# on Render if any of the three is set.
EVAL_GROQ_API_KEYS=
EVAL_GEMINI_API_KEYS=
EVAL_OPENROUTER_API_KEYS=

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# Web address of your Qdrant cloud cluster (vector search).
# Leave it unset when you run tests: tests use an in-memory Qdrant.
# [P] Name chosen by the builder.
# Where: Render and local
QDRANT_URL=

# API key of your Qdrant cloud cluster.
# [P] Name chosen by the builder.
# Where: Render and local
QDRANT_API_KEY=

# Main database: a cloud Postgres connection URL (Neon or Supabase), for example
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# TLS is required: keep sslmode=require in the URL. When you run migrations, use
# the provider's DIRECT connection URL, not the pooled one (the pooled host on
# Neon contains "-pooler"; Supabase calls it the transaction pooler).
# Tests never use this: they use SQLite, and refuse to run if this points at a
# remote host. Put it in your shell only when you run migrations or the app.
# [P] Name chosen by the builder.
# Where: Render and local
DATABASE_URL=

# Evaluation database: a separate cloud Postgres database (same URL format and
# TLS rule as above) that holds PRODUCTION evaluation results only. Local
# evaluation results go to a SQLite file by default (confirmed in Phase 13).
# [P] Name chosen by the builder.
# Where: admin machine only
EVAL_DATABASE_URL=

# Upstash Redis address for the answer cache and rate limits (starts with rediss://).
# [P] Name chosen by the builder.
# Where: Render and local
UPSTASH_REDIS_URL=

# Seconds an answer stays in the cache at most. It is only a backstop: a changed document
# removes its cached answers at once, whatever this says. Default: 86400 (24 hours).
# [P] Name and default chosen by the builder.
# Where: Render and local
CACHE_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Tracing, alerts and security
# ---------------------------------------------------------------------------

# Langfuse project keys and the address of your Langfuse region (tracing).
# [P] Names chosen by the builder, following Langfuse's own documentation.
# Where: Render and local
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Secret used to sign login tokens. It must be 32 random bytes (43 or more characters), different on
# every environment. The app refuses to start if it is empty, short, a placeholder, a repeated
# pattern, a keyboard run, or related to AUDIT_HASH_KEY. Make one in your own terminal, and never
# paste the result into a chat or a file that is committed (a 64 character hex key from
# `openssl rand -hex 32` is accepted too):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# [P] Name chosen by the builder.
# Where: Render and local
JWT_SECRET_KEY=

# A second, different secret that keys the hashes of usernames in audit rows and in throttle
# counters, so a typed username is never stored. Same rules as JWT_SECRET_KEY, and it must not be
# the same value. Make it with the same command, run a second time.
# [P] Name chosen by the builder.
# Where: Render and local
AUDIT_HASH_KEY=

# How long a login lasts, in minutes. Default: 480 (8 hours). There are no refresh tokens: after
# this the user signs in again.
# [P] Name and default chosen by the builder.
# Where: Render and local
JWT_EXPIRE_MINUTES=

# Tokens one user may use per day (UTC day, resets at 00:00 UTC). Customers default to 50000
# (spec 5.4). Staff and admins default to 200000, a placeholder to calibrate after the baseline.
# [P] Names chosen by the builder.
# [T] The staff value is a placeholder: confirm it before launch.
# Where: Render and local
TOKEN_BUDGET_CUSTOMER=
TOKEN_BUDGET_STAFF=

# How many password hashes may run at the same time. Each uses about 19 MiB of memory, so on a
# small host a few at once is the safe number. A request that finds every slot taken is not queued:
# it gets a "busy, try again" answer at once. Default: 2. Allowed: 1 to 16.
# [P] Name and default chosen by the builder.
# Where: Render and local
PASSWORD_HASH_CONCURRENCY=

# The web address of the Streamlit frontend, the only site allowed to call the API.
# [P] Name chosen by the builder.
# Where: Render and local
CORS_ALLOWED_ORIGIN=

# Web address of the chat webhook that receives alerts (no email in this version).
# [P] Name chosen by the builder.
# Where: Render and local
ALERT_WEBHOOK_URL=

# Set to true to print each pipeline stage and its timing in your terminal while
# a query runs. Leave empty everywhere else; it must stay off on Render.
# The spec names this flag (section 14).
# Where: admin machine only
DEV_STAGE_TRACE=

# ---------------------------------------------------------------------------
# Gateway: models, limits and switches (spec section 5)
# Leave a variable empty to use its default. The default is shown in the comment.
# ---------------------------------------------------------------------------

# Groq models: GROQ_MODEL answers questions, GROQ_DECIDE_MODEL makes quick decisions.
# Defaults: openai/gpt-oss-120b and openai/gpt-oss-20b.
# [P] Names chosen by the builder.
# Where: Render and local
GROQ_MODEL=
GROQ_DECIDE_MODEL=

# Gemini models. GEMINI_DECIDE_MODEL uses the same model as GEMINI_MODEL when empty.
# Default: gemini-3.8-flash.
# [P] Names chosen by the builder.
# Where: Render and local
GEMINI_MODEL=
GEMINI_DECIDE_MODEL=

# OpenRouter models for answers and for decisions. Default for both: google/gemma-4-31b-it:free.
# If you have paid OpenRouter credit you may set the decide model to openai/gpt-oss-20b.
# [P] Names chosen by the builder.
# Where: Render and local
OPENROUTER_MODEL=
OPENROUTER_DECIDE_MODEL=

# The Jev model. Keep it pinned to an exact version, never the router or the latest alias,
# so a change of model shows up as drift. Default: typesafe/jev-1.13. The gateway refuses to
# start if this names a router, a latest alias or a name starting with "~".
# [P] Name chosen by the builder.
# Where: Render and local
JEV_MODEL=

# The embedding model. Default: gemini-embedding-2 (768 dimensions). Vectors from different
# embedding models cannot be compared, so never change it without re-indexing every document.
# [P] Name chosen by the builder.
# Where: Render and local
GEMINI_EMBEDDING_MODEL=

# Rerank models. Defaults: rerank-v3.5 (Cohere) and jina-reranker-v3 (Jina).
# [P] Names chosen by the builder.
# Where: Render and local
COHERE_RERANK_MODEL=
JINA_RERANK_MODEL=

# Rate limits per key, one variable per provider, written like rpm=30,tpm=8000,rpd=1000,tpd=200000
# (use none for no limit). Only the fields you write change. Defaults: Groq 30 requests and 8000
# tokens a minute, 1000 requests and 200000 tokens a day; OpenRouter 20 a minute and 50 a day;
# Gemini 10 a minute and 250000 tokens; Jev 20 a minute; embeddings 10 a minute; Cohere 10 a
# minute; Jina 100 a minute and 100000 tokens. Several of these are unpublished [T]: check your
# provider consoles. Gemini limits apply per Google project, not per key.
# [P] Names chosen by the builder.
# Where: Render and local
GATEWAY_LIMITS_GROQ=
GATEWAY_LIMITS_GEMINI=
GATEWAY_LIMITS_OPENROUTER=
GATEWAY_LIMITS_JEV=
GATEWAY_LIMITS_EMBEDDING=
GATEWAY_LIMITS_COHERE=
GATEWAY_LIMITS_JINA=

# Billing plan per provider: free or paid. On a free plan the billed cost is shown as $0 and
# the shadow cost (the list price) is still shown, always labelled separately. The pilot uses
# free tiers, so the defaults are free for Groq, Gemini, OpenRouter and the embeddings, and
# paid for Jev (it is charged per input token). Set a provider to paid when you buy a plan.
# Rerank calls are not costed yet.
# [P] Names chosen by the builder.
# Where: Render and local
GATEWAY_PLAN_GROQ=
GATEWAY_PLAN_GEMINI=
GATEWAY_PLAN_OPENROUTER=
GATEWAY_PLAN_JEV=
GATEWAY_PLAN_EMBEDDING=

# Seconds to wait for one model call before giving up. Default: 10.
# [P] Name chosen by the builder.
# Where: Render and local
GATEWAY_TIMEOUT_SECONDS=

# Context window overrides for models whose real limit is lower than LiteLLM's table, written
# like gemini/some-model=64000,openrouter/some-model:free=32000. Default: none.
# [P] Name chosen by the builder.
# Where: Render and local
GATEWAY_CONTEXT_OVERRIDES=

# Reasoning models (Gemini 3.x, Groq gpt-oss) think before they answer, and the thinking tokens
# count against the output limit. Too small a limit leaves no room for any text. The allowance
# is added to the answer limit (400 for answers, 500 for JSON): the total is what is sent to
# the provider and what the rate limiter reserves. Default: 512 tokens. An answer that comes
# back empty is retried once with twice the room and the lowest thinking level, and is never
# returned as an answer.
# [P] Name chosen by the builder.
# Where: Render and local
GATEWAY_REASONING_ALLOWANCE_TOKENS=

# How hard the models think: low, medium, high, or off (send no setting). Default: low for both.
# "minimal" is not accepted because Gemini rejects it. One value for answers, one for decisions.
# [P] Names chosen by the builder.
# Where: Render and local
GATEWAY_REASONING_EFFORT_ANSWER=
GATEWAY_REASONING_EFFORT_DECIDE=

# Set to true to allow the labelled offline mock answer as a last resort when every provider
# is down. Default: off. Leave it off in production: users should see "temporarily unavailable".
# [P] Name chosen by the builder.
# Where: admin machine only
GATEWAY_ENABLE_MOCK=

# Ingestion (Phase 5). The company names that ingestion treats as public terms when it builds the
# entity allow-list (spec 6.8), separated by commas. Default: the sample company, "AuraVance Digital
# FinTech Private Limited" and "AuraVance".
# [P] Name chosen by the builder.
# [T] Placeholder value: set the real company name before real documents are ingested.
# Where: admin machine only
COMPANY_NAMES=

# The company's own domains, separated by commas. Ingestion (Phase 5) allow-lists an email or web
# address in a document as a helpline only when its domain is one of these or a regulator's domain
# built into the program; any other one waits for your review. The answer guardrails (Phase 6) keep
# a web address in a model answer as plain text only for these same domains; every other address is
# removed. Default: the sample company's domain, "auravance.aura".
# [P] Name chosen by the builder.
# [T] Placeholder value: set the real company domains before real documents are ingested.
# Where: Render and local
COMPANY_DOMAINS=

# Memory (Phase 7). How many tokens of the most recent turns the rewrite step sees word for word
# (spec 8.2). A whole number from 50 to 4000; empty means 400. The spec says to compare 200, 400,
# 800 and 1,200 on the multi-turn evaluation set and keep the smallest size where rewrite accuracy
# stops improving; that comparison is done at the Phase 16 baseline run.
# [P] Name chosen by the builder.
# [T] Starting value 400, tuned at the baseline.
# Where: Render and local
MEMORY_BUFFER_TOKENS=
